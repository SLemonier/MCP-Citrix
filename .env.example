# === Required ===
# Citrix Cloud API client ID
CITRIX_CLIENT_ID=
# Citrix Cloud API client secret
CITRIX_CLIENT_SECRET=
# Citrix Cloud customer ID
CITRIX_CUSTOMER_ID=
# Site/instance ID (from /Me endpoint)
CITRIX_INSTANCE_ID=

# === Optional ===
# Region: us | eu | ap-s (default: us)
# CITRIX_REGION=us
# Override for on-prem (e.g. https://ddc.corp.local) — leave commented out for Citrix Cloud
# CITRIX_BASE_URL=https://your-ddc.corp.local
# Base64-encoded domain\user:password for on-prem auth
# CITRIX_ADMIN_CREDENTIAL=
# Log level: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO
